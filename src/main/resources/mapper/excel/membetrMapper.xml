<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.react.ming.test.src.mapper.MemberMapper">

  <insert id="insertMember">
    <selectKey keyProperty="memberId" resultType="Long" order="BEFORE">
      SELECT NEXT VALUE FOR member_seq
    </selectKey>
    INSERT INTO member (member_Id, username, age)
    VALUES (#{memberId}, #{username}, #{age})
  </insert>

  <select id="selectMemeber" resultType="com.react.ming.test.src.dto.MemberDto">
    SELECT * FROM member
    WHERE member_id = #{memberId}
  </select>
</mapper>